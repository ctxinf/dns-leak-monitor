[Unit]
Description=DNS Leak Monitor
After=network.target

[Service]
ExecStart=/usr/local/bin/dns-leak-monitor --config /etc/dns-leak-monitor/config.toml
ExecReload=/bin/kill -HUP $MAINPID
User=dnswatch
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dns-leak-monitor /etc/dns-leak-monitor
Restart=on-failure

[Install]
WantedBy=multi-user.target
